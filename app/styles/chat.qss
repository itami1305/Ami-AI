/* ============================================================ */
/* CHAT MODULE STYLE                                              */
/* ============================================================ */

/* ----- Chat card (toàn bộ khung hội thoại) ------------------- */
QFrame#chat_card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

/* Header của chat card */
QLabel#chat_head_title {
    color: #111827;
    font-size: 12pt;
    font-weight: 600;
}
QLabel#chat_head_meta {
    color: #6b7280;
    font-size: 9pt;
}
QLabel#chat_badge_model {
    background: #fee2e2;
    color: #dc2626;
    font-weight: 600;
    font-size: 9pt;
    padding: 3px 9px;
    border-radius: 999px;
}

/* ----- Khu vực bubbles ---------------------------------------- */
QScrollArea#chat_scroll {
    background: #ffffff;
    border: none;
}
QWidget#chat_content {
    background: #ffffff;
}

/* ----- Bubble chung ------------------------------------------- */
QFrame[role="bubble"] {
    border-radius: 12px;
}

/* User bubble (đỏ nhạt) */
QFrame#bubble_user {
    background: #fef2f2;
    border: 1px solid #fee2e2;
    border-radius: 12px;
}
QLabel#bubble_sender_user {
    color: #dc2626;
    font-weight: 600;
    font-size: 10pt;
}
QLabel#bubble_content_user {
    color: #111827;
    font-size: 10pt;
}

/* AI bubble (xám nhạt) */
QFrame#bubble_ai {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}
QLabel#bubble_sender_ai {
    color: #111827;
    font-weight: 600;
    font-size: 10pt;
}
QLabel#bubble_content_ai {
    color: #111827;
    font-size: 10pt;
}

/* System bubble (xám nhỏ) */
QFrame#bubble_system {
    background: transparent;
    border: 1px dashed #e5e7eb;
    border-radius: 10px;
}
QLabel#bubble_sender_system {
    color: #9ca3af;
    font-weight: 600;
    font-size: 9pt;
}
QLabel#bubble_content_system {
    color: #6b7280;
    font-size: 9pt;
}

/* Thinking bubble (italic, animated dots) */
QFrame#bubble_thinking {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}
QLabel#bubble_sender_thinking {
    color: #111827;
    font-weight: 600;
    font-size: 10pt;
}
QLabel#bubble_content_thinking {
    color: #6b7280;
    font-style: italic;
    font-size: 10pt;
}

/* Error bubble */
QFrame#bubble_error {
    background: #fee2e2;
    border: 1px solid #fca5a5;
    border-radius: 12px;
}
QLabel#bubble_sender_error {
    color: #b91c1c;
    font-weight: 600;
    font-size: 10pt;
}
QLabel#bubble_content_error {
    color: #b91c1c;
    font-size: 10pt;
}

/* ----- Input bar ---------------------------------------------- */
QLineEdit#chat_input {
    background: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 10pt;
}
QLineEdit#chat_input:focus {
    border-color: #ef4444;
}

QLabel#chat_hint {
    color: #6b7280;
    font-size: 9pt;
}

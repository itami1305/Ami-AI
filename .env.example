# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Backend (dùng bởi Win App)
BACKEND_URL=http://127.0.0.1:8000

# Timeout
HTTP_TIMEOUT=120

# Automation
SCROLL_AMOUNT=3
SCROLL_PIXELS_PER_CLICK=120
SCROLL_PAUSE=0.8
CHAT_LOAD_WAIT=1.5

# Crop đầu cửa sổ khi chụp (Win app — app/config.py)
CHAT_TOP_SKIP_PX=200
# Vùng OCR khung chat (Backend — preset theo app_type; chỉ set khi cần tinh chỉnh)
# zalo_pc: sidebar 22%, panel phải 25%, header 6%, ô nhập 8%
# zalo_web (Zalo trên Chrome): panel phải 0% — tránh mất tin bên phải
# CHAT_SIDEBAR_RATIO=0.18
# CHAT_RIGHT_RATIO=0
# CHAT_INNER_TOP_RATIO=0.08
# CHAT_BOTTOM_RATIO=0.10

# OCR bubble: tâm bubble phải hơn tỉ lệ này trên chiều rộng khung chat → tin mình (self). Dùng 0.45 nếu chat RTL / theme lạ.
OCR_SELF_RIGHT_RATIO=0.48
